# S Finder - Example Keystore Configuration
# Copy this file to 'keystore.properties' and fill in your actual keystore credentials.
# NEVER commit keystore.properties or keystore files (*.jks) to version control.
storeFile=your-upload-keystore.jks
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=your-key-alias
keyPassword=YOUR_KEY_PASSWORD_HERE
